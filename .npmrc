# Link workspace packages when a plain semver range matches a local package.
#
# pnpm 10 defaults this to false, so a dependency only resolves locally when it
# uses the `workspace:` protocol. We deliberately do not use that protocol:
# `npm publish` does not rewrite it, and the trusted-publishing path in
# publish-package.yml goes through npm, so a published manifest would carry
# `workspace:^` and be uninstallable. Plain ranges plus this setting give both —
# local development links the workspace copy, and what ships is valid semver.
# `pnpm verify:report-cli` asserts the range still admits the local version.
link-workspace-packages=true

# Storybook's core resolves its framework package (@storybook/react-vite) from
# its own location in the store rather than from the package that depends on it.
# In a single-package repo that happened to work; in a workspace it does not, and
# `pnpm build-storybook` fails with ERR_MODULE_NOT_FOUND. Hoisting the storybook
# packages to the root node_modules is pnpm's documented workaround.
public-hoist-pattern[]=*storybook*
