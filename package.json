{
  "name": "@rtkelly13/design-system-monorepo",
  "private": true,
  "description": "Workspace root. The published packages are under packages/.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @rtkelly13/design-system build && pnpm --filter @rtkelly13/design-system-report build",
    "typecheck": "pnpm --filter @rtkelly13/design-system typecheck && pnpm --filter @rtkelly13/design-system build && pnpm --filter @rtkelly13/design-system-report typecheck",
    "test": "pnpm -r test",
    "check:deps": "pnpm -r check:deps",
    "report": "pnpm --filter @rtkelly13/design-system-report report",
    "verify:report-cli": "pnpm --filter @rtkelly13/design-system-report verify:report-cli",
    "contrast:report:html": "pnpm build && node packages/design-system-report/dist/cli.js packages/design-system/reports/contrast.tsx",
    "tokens:build": "pnpm --filter @rtkelly13/design-system tokens:build",
    "tokens:check": "pnpm --filter @rtkelly13/design-system tokens:check",
    "check:contrast": "pnpm --filter @rtkelly13/design-system check:contrast",
    "contrast:report": "pnpm --filter @rtkelly13/design-system contrast:report",
    "check:tokens": "pnpm --filter @rtkelly13/design-system check:tokens",
    "check:css": "pnpm --filter @rtkelly13/design-system check:css",
    "check:visual-coverage": "pnpm --filter @rtkelly13/design-system check:visual-coverage",
    "storybook": "pnpm --filter @rtkelly13/design-system storybook",
    "build-storybook": "pnpm --filter @rtkelly13/design-system build-storybook",
    "test:visual": "pnpm --filter @rtkelly13/design-system test:visual",
    "walkthrough": "pnpm --filter @rtkelly13/design-system walkthrough"
  },
  "packageManager": "pnpm@10.33.0"
}
